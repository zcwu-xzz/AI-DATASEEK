#!/usr/bin/expect -f
set timeout 240
set command {cd /root/AI-DataSeek && ./run.sh ps && docker exec ai-dataseek-backend-1 python -c "import json,pathlib; print('TOOL_COUNT='+str(sum(len(json.loads(p.read_text()).get('tools', [])) for p in pathlib.Path('/opt/ai-dataseek/tools').glob('*/manifest.json'))))" && docker exec ai-dataseek-backend-1 python -c "import json,urllib.request; p=json.load(urllib.request.urlopen('http://127.0.0.1:8000/openapi.json'))['paths']; print('ALIGNMENT_ROUTES='+str(all(x in p for x in ['/api/v1/files/alignment-preview/prepare','/api/v1/files/alignment-preview/region','/api/v1/files/alignment-preview/release'])))" && docker run --rm --entrypoint /bin/bash ai-dataseek-sandbox:latest -lc "printf '%s\n' '>gene1' 'CCCATGAAATAGGGGATGCCCTAA' > /tmp/test.fa; ai-dataseek-tool run sequence_motif_search --arguments-base64 eyJpbnB1dF9wYXRoIjoiL3RtcC90ZXN0LmZhIiwibW90aWYiOiJBVEciLCJib3RoX3N0cmFuZHMiOnRydWV9" && docker run --rm --entrypoint /bin/bash ai-dataseek-sandbox:latest -lc "printf '%b\n' '##fileformat=VCFv4.2' '#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\ts1\ts2' 'chr1\t10\trs1\tA\tG\t60\tPASS\t.\tGT\t0/1\t1/1' 'chr1\t20\trs2\tC\tA\t50\tPASS\t.\tGT\t0/0\t./.' > /tmp/test.vcf; ai-dataseek-tool run vcf_sample_qc --arguments-base64 eyJpbnB1dF9wYXRoIjoiL3RtcC90ZXN0LnZjZiJ9" && curl -fsS -o /dev/null -w 'PUBLIC_HTTP=%{http_code}\n' http://127.0.0.1:7000/}
spawn ssh -tt -o StrictHostKeyChecking=no -o PreferredAuthentications=password -o PubkeyAuthentication=no root@39.106.98.67 $command
expect {
  -re {password:} { send -- "Km159870610@\r"; exp_continue }
  timeout { exit 2 }
  eof { catch wait result; exit [lindex $result 3] }
}
