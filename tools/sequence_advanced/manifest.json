{
  "plugin": "sequence_advanced",
  "version": "1.0.0",
  "handler": "handler.py",
  "tools": [
    {"name":"fasta_index_query","description":"复制并索引大型 FASTA，在不修改只读源数据的前提下按序列和坐标提取区域。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"sequence_id":{"type":["string","null"]},"start":{"type":"integer","default":1},"end":{"type":["integer","null"]}},"required":["input_path","output_path"]}},
    {"name":"fasta_id_subset","description":"按序列标识清单保留或排除 FASTA 序列并生成新的 FASTA。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"ids":{"type":"array","items":{"type":"string"}},"ids_path":{"type":["string","null"]},"exclude":{"type":"boolean","default":false}},"required":["input_path","output_path"]}},
    {"name":"fasta_split_merge","description":"按记录数量拆分 FASTA，或将多个 FASTA 文件合并为一个数据产品。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"input_path":{"type":["string","null"]},"input_paths":{"type":"array","items":{"type":"string"}},"output_path":{"type":"string"},"mode":{"type":"string","enum":["split","merge"]},"records_per_file":{"type":"integer","default":1000}},"required":["output_path","mode"]}},
    {"name":"fasta_id_normalize","description":"标准化 FASTA 序列标识，处理空格、特殊字符和重复标识，并输出名称映射表。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"mapping_path":{"type":["string","null"]},"prefix":{"type":"string","default":"sequence"}},"required":["input_path","output_path"]}},
    {"name":"fasta_assembly_metrics","description":"计算组装序列总长度、N50、L50、N90、L90、最大序列、GC 和 N 比例。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"genome_size":{"type":["integer","null"]}},"required":["input_path"]}},
    {"name":"fasta_gap_profile","description":"识别 FASTA 中连续 N 缺口，统计缺口数量、长度、位置和有效碱基比例。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]},"min_gap":{"type":"integer","default":1}},"required":["input_path"]}},
    {"name":"fasta_window_composition","description":"按滑动窗口计算 GC、N、GC 偏移和序列复杂度并导出表格。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"window_size":{"type":"integer","default":10000},"step_size":{"type":["integer","null"]}},"required":["input_path","output_path"]}},
    {"name":"fasta_msa_profile","description":"分析多序列比对 FASTA 的一致序列、保守度、信息熵、缺口率和变异位点。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"fasta_annotation_extract","description":"结合 GFF 或 GTF 从参考 FASTA 提取基因、转录本、CDS、外显子或启动子序列。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"fasta_path":{"type":"string"},"annotation_path":{"type":"string"},"output_path":{"type":"string"},"feature_type":{"type":"string","default":"CDS"},"upstream":{"type":"integer","default":0}},"required":["fasta_path","annotation_path","output_path"]}},
    {"name":"protein_fasta_properties","description":"计算蛋白 FASTA 的分子量、理论等电点、芳香性、不稳定指数、疏水性和氨基酸组成。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"fastq_adapter_detect","description":"从 FASTQ 读段末端和过度富集序列中识别常见或候选接头序列。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"max_reads":{"type":"integer","default":200000},"k":{"type":"integer","default":12}},"required":["input_path"]}},
    {"name":"fastq_quality_trim","description":"按末端质量或滑动窗口质量剪切 FASTQ，并应用最短长度和最大 N 比例过滤。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"min_quality":{"type":"integer","default":20},"window_size":{"type":"integer","default":4},"min_length":{"type":"integer","default":30},"max_n_fraction":{"type":"number","default":0.1},"poly_x_min":{"type":"integer","default":10}},"required":["input_path","output_path"]}},
    {"name":"fastq_paired_clean","description":"同步清洗双端 FASTQ，输出成对保留读段和可选孤立读段，确保配对关系不丢失。","scopes":["dataset_fast_path"],"timeout_seconds":300,"parameters":{"type":"object","properties":{"read1_path":{"type":"string"},"read2_path":{"type":"string"},"output_read1":{"type":"string"},"output_read2":{"type":"string"},"orphan_path":{"type":["string","null"]},"min_quality":{"type":"integer","default":20},"min_length":{"type":"integer","default":30}},"required":["read1_path","read2_path","output_read1","output_read2"]}},
    {"name":"fastq_pair_repair","description":"按读段名称重新同步错序或缺失的双端 FASTQ，并输出孤立读段。","scopes":["dataset_fast_path"],"timeout_seconds":300,"parameters":{"type":"object","properties":{"read1_path":{"type":"string"},"read2_path":{"type":"string"},"output_read1":{"type":"string"},"output_read2":{"type":"string"},"orphan_path":{"type":"string"},"max_records":{"type":"integer","default":2000000}},"required":["read1_path","read2_path","output_read1","output_read2","orphan_path"]}},
    {"name":"fastq_interleave_convert","description":"将 R1/R2 转换为交错 FASTQ，或将交错 FASTQ 拆分为双端文件。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"mode":{"type":"string","enum":["interleave","deinterleave"]},"input_path":{"type":["string","null"]},"read1_path":{"type":["string","null"]},"read2_path":{"type":["string","null"]},"output_path":{"type":["string","null"]},"output_read1":{"type":["string","null"]},"output_read2":{"type":["string","null"]}},"required":["mode"]}},
    {"name":"fastq_pair_merge","description":"根据双端读段重叠区域合并 R1/R2，输出合并序列和未合并双端序列。","scopes":["dataset_fast_path"],"timeout_seconds":300,"parameters":{"type":"object","properties":{"read1_path":{"type":"string"},"read2_path":{"type":"string"},"output_path":{"type":"string"},"unmerged_read1":{"type":["string","null"]},"unmerged_read2":{"type":["string","null"]},"min_overlap":{"type":"integer","default":20},"max_mismatch_rate":{"type":"number","default":0.1}},"required":["read1_path","read2_path","output_path"]}},
    {"name":"fastq_demultiplex","description":"按条形码映射将混合 FASTQ 拆分为多个样本，并报告各样本和未识别读段数量。","scopes":["dataset_fast_path"],"timeout_seconds":300,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_dir":{"type":"string"},"barcodes":{"type":"object","additionalProperties":{"type":"string"}},"barcode_position":{"type":"string","enum":["start","end"],"default":"start"},"max_mismatches":{"type":"integer","default":0}},"required":["input_path","output_dir","barcodes"]}},
    {"name":"fastq_umi_extract","description":"从读段序列或名称中提取 UMI，写入读段名称并输出去除 UMI 后的 FASTQ。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"},"umi_length":{"type":"integer"},"source":{"type":"string","enum":["sequence_start","sequence_end","name"],"default":"sequence_start"}},"required":["input_path","output_path","umi_length"]}},
    {"name":"fastq_downsample","description":"按比例或目标读段数随机降采样 FASTQ，支持成对同步抽样和固定随机种子。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"other_path":{"type":["string","null"]},"output_path":{"type":"string"},"other_output_path":{"type":["string","null"]},"fraction":{"type":["number","null"]},"target_reads":{"type":["integer","null"]},"seed":{"type":"integer","default":42}},"required":["input_path","output_path"]}},
    {"name":"fastq_overrepresented_sequences","description":"分析 FASTQ 重复层级、过度富集序列、末端高频片段和候选污染序列。","scopes":["dataset_fast_path"],"timeout_seconds":180,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"max_reads":{"type":"integer","default":500000},"top_n":{"type":"integer","default":50}},"required":["input_path"]}},
    {"name":"fastq_contamination_screen","description":"使用用户提供的污染物参考 FASTA，通过 k-mer 匹配筛查 FASTQ 并输出污染比例和匹配来源。","scopes":["dataset_fast_path"],"timeout_seconds":300,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"reference_path":{"type":"string"},"output_path":{"type":["string","null"]},"k":{"type":"integer","default":21},"min_matches":{"type":"integer","default":2}},"required":["input_path","reference_path"]}},
    {"name":"fastq_long_read_qc","description":"面向 Nanopore 或 PacBio FASTQ 计算产量、长度 N50、质量与长度关系及累计产量。","scopes":["dataset_fast_path"],"timeout_seconds":240,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
    {"name":"fastq_qc_clean_workflow","description":"一次完成 FASTQ 清洗前后质控、质量剪切、双端同步、统计报告和交互式质量图。","scopes":["dataset_fast_path"],"timeout_seconds":300,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"other_path":{"type":["string","null"]},"output_dir":{"type":"string"},"min_quality":{"type":"integer","default":20},"min_length":{"type":"integer","default":30}},"required":["input_path","output_dir"]}},
    {"name":"reference_prepare_workflow","description":"复制参考 FASTA 到可写输出目录，标准化标识并生成 FAI 索引、序列字典和质量报告。","scopes":["dataset_fast_path"],"timeout_seconds":300,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_dir":{"type":"string"},"normalize_ids":{"type":"boolean","default":false}},"required":["input_path","output_dir"]}}
  ]
}
